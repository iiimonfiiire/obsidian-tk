{
  "name": "obsidian-tk",
  "version": "0.1.0",
  "description": "Track [TK: ...] placeholders in Obsidian.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "install-plugin": "npm run build && node scripts/install.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
